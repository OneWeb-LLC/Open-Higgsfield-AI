# Shared Supabase (One OS / OWeb constellation)
SUPABASE_PROJECT_ID=ebjzdcnphkfpxfldnatm
SUPABASE_URL=https://auth.oweb.one
NEXT_PUBLIC_SUPABASE_URL=https://auth.oweb.one
SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# OWeb control plane (SSO redeem: POST /api/v1/ecosystem/redeem-launch-token)
NEXT_PUBLIC_OWEB_APP_URL=https://oweb.one
NEXT_PUBLIC_OWEB_PLATFORM_API_URL=https://oweb.one/api/v1

# This satellite public URL (SSO return target — set in Vercel)
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Enforce OneID on /studio (default: true in production)
NEXT_PUBLIC_OHF_REQUIRE_AUTH=true

# Generative API (MuAPI) — optional
# MUAPI_UPSTREAM=https://api.muapi.ai
# NEXT_PUBLIC_OHF_DEFAULT_API_PROVIDER=muapi-proxy
# Optional extra provider (sync from oweb BACKEND_API_URL via npm run sync:vercel-env)
# OHF_OWEB_BACKEND_API_UPSTREAM=
# NEXT_PUBLIC_OHF_OWEB_BACKEND_LABEL=OWeb backend API
# OHF_CUSTOM_API_UPSTREAM=
# NEXT_PUBLIC_OHF_CUSTOM_API_LABEL=Custom API
